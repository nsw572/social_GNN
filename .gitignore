/*
!/.gitignore
!/README.md
!/social_gnn/
!/configs/
!/tests/

**/__pycache__/
*.py[cod]
*.log
*.mp4
*.avi
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.csv
*.json
